# Clerk dashboard → API keys. Enable email sign-in with email verification.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Your verified Clerk account email; set this BEFORE exposing the deployment.
ADMIN_EMAIL=your-email@example.com
# Turso → database connection details. Server-only; never prefix these NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Canonical HTTPS deployment origin, e.g. https://creators.yourbrand.com
APP_URL=http://localhost:3000
